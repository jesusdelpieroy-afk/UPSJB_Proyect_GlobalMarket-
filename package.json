{
  "name": "global-market",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "sass": "sass scss/custom.scss css/custom.css --style=expanded --quiet",
    "sass:watch": "sass scss/custom.scss css/custom.css --watch --quiet",
    "build": "npm run sass && purgecss --config purgecss.config.js",
    "start": "npx serve ."
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "bootstrap-icons": "^1.11.3"
  },
  "devDependencies": {
    "sass": "^1.77.0",
    "purgecss": "^6.0.0"
  }
}